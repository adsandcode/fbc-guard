{
  "name": "mcp-server-fbc-guard",
  "version": "0.1.0",
  "mcpName": "io.github.adsandcode/fbc-guard",
  "description": "MCP server and CLI that statically checks landing-page JavaScript for Meta click ID (_fbc, fbclid) and browser ID (_fbp) implementation mistakes.",
  "keywords": [
    "meta",
    "facebook",
    "conversions-api",
    "capi",
    "fbclid",
    "fbc",
    "fbp",
    "pixel",
    "tracking",
    "attribution",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "landing-page",
    "ci"
  ],
  "license": "MIT",
  "homepage": "https://adsandcode.com/en/open-source/fbc-guard/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adsandcode/fbc-guard.git"
  },
  "bugs": {
    "url": "https://github.com/adsandcode/fbc-guard/issues"
  },
  "author": "Ads & Code (https://adsandcode.com)",
  "type": "module",
  "main": "dist/rules.js",
  "types": "dist/rules.d.ts",
  "bin": {
    "mcp-server-fbc-guard": "dist/index.js",
    "fbc-guard": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "selftest": "node dist/selftest.js",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm run selftest && node scripts/smoke.mjs && node scripts/check-publish-ready.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
}
